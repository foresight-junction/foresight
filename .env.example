# Copy to .env (gitignored). Never commit real keys.

# Model keys, host only. The runner maps GEMINI_API_KEY to OpenCode’s Google provider key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# make eval, host only. Agent model as <provider/model>; the provider picks the key above.
ED72_MODEL=
# Optional Harbor command override (default: uvx --python 3.12 --from harbor==0.26.0 harbor).
# HARBOR=

# 1 = use mocked data/calls (AGENTS.md section 7). Every mock is marked MOCK:.
USE_MOCKS=0

# Hospital sidecar only, set in docker-compose.yaml. Never put these in the
# main (agent) container: they would reveal the world to the agent.
# ED72_SEED=
# ED72_CONFIG=
