# Copy to .env (gitignored). Never commit real keys.

# Model keys, host only. Harbor passes them to the agent.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Host only, for make eval (#23): the agent model as <provider/model>, e.g.
# gemini/gemini-3.8-flash (the provider prefix picks the key above), and an
# optional Harbor command override (default: uvx --python 3.12 --from harbor==0.25.0 harbor).
ED72_MODEL=
HARBOR=

# 1 = use mocked data/calls (AGENTS.md section 7). Every mock is marked MOCK:.
USE_MOCKS=0

# Hospital sidecar only, set in docker-compose.yaml. Never put these in the
# main (agent) container: they would reveal the world to the agent.
# ED72_SEED=
# ED72_CONFIG=
